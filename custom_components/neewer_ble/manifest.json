{
  "domain": "neewer_ble",
  "name": "Neewer BLE Lights",
  "bluetooth": [
    {
      "local_name": "NEEWER*"
    },
    {
      "local_name": "NW-*"
    }
  ],
  "codeowners": [
    "@darinlarimore"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/darinlarimore/neewer-ble-homeassistant",
  "integration_type": "device",
  "iot_class": "assumed_state",
  "issue_tracker": "https://github.com/darinlarimore/neewer-ble-homeassistant/issues",
  "requirements": [
    "bleak>=0.21.0",
    "bleak-retry-connector>=3.0.0"
  ],
  "version": "0.3.0-beta.1"
}
